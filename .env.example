# AlphaPai credential - OPTIONAL, and not the recommended route.
#
# Preferred: store the credential in your OS keystore instead, where it is
# ACL-protected and cannot be committed:
#   Windows  scripts/Open-AlphaPaiCredentialPrompt.ps1
#   macOS    security add-generic-password -s 'AlphaPai:Login' -a '<account>' -w
#
# Use this file only where no keystore exists - CI, a container, a headless
# Linux host. A password here is plaintext at rest and readable by any process
# running as you.
#
# Copy to `.env` (already git-ignored) and fill in. The loader refuses a .env
# that git tracks. If one is ever committed, rotate the password.

ALPHAPAI_USERNAME=
ALPHAPAI_PASSWORD=
